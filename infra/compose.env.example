# Copy to an ignored environment file. Paths point to files projected by the deployment secret store.
MNS_SECRETS_DIR=/run/mns-suporte/database-and-api
MNS_BACKUP_KEY_FILE=/run/mns-suporte-backup/archive.key
MNS_BACKUP_DIR=/var/lib/mns-suporte/backups
MNS_BACKUP_UID=1000
MNS_BACKUP_GID=1000
MNS_API_IMAGE=mns-suporte-api:v1-rc
MNS_MIGRATION_IMAGE=mns-suporte-migration:v1-rc
MNS_BACKUP_IMAGE=mns-suporte-backup:v1-rc
MNS_RELEASE_ID=v1-rc
MNS_ENVIRONMENT=production
MNS_API_PORT=3000
