# Local API development example. Copy to .env.local; never commit real values.
# The keys and safe defaults below are checked against apps/api/src/config.ts.
# See docs/setup.md and docs/generated/configuration/api.md.
ORION_ENV=development

# ORION_RELEASE_ID=local  # Actual artifact revision for correlated logs and traces; local for unversioned development.
# ORION_API_HOST=127.0.0.1  # Listen address; loopback by default.
# ORION_API_PORT=3000  # Listen port; zero selects an ephemeral port.
# ORION_LOG_LEVEL=info  # Structured log threshold.
# ORION_SHUTDOWN_TIMEOUT_MS=5000  # Total graceful shutdown deadline.
# ORION_OTLP_ENDPOINT: Optional OTLP HTTP collector base URL.
# ORION_TRACE_SAMPLE_RATIO=1  # Trace sampling probability.
# ORION_DATABASE_URL: Runtime PostgreSQL credential; enables the database for modules that require it and adds it to readiness.
# ORION_TOKEN_ISSUER: Expected access-token issuer; configure with audience and JWKS URL to enable bearer authentication.
# ORION_TOKEN_AUDIENCE: Expected API access-token audience.
# ORION_TOKEN_JWKS_URL: Trusted issuer public-key endpoint.
# WHATSAPP_APP_SECRET: Meta app secret used to verify incoming webhook signatures.
# WHATSAPP_WEBHOOK_VERIFY_TOKEN: Application-generated secret used to verify the Meta callback.
# WHATSAPP_PHONE_NUMBER_ID: Meta business phone number ID accepted by the webhook.
# WHATSAPP_ACCESS_TOKEN: Meta system user token that enables WhatsApp outbound dispatch.
# WHATSAPP_GRAPH_API_VERSION=v27.0  # Graph API version used by WhatsApp outbound dispatch.
# WHATSAPP_CLOSURE_TEMPLATE_NAME: Approved pt_BR utility template for closure notices outside the customer service window.
# GLPI_API_URL: Base URL of the GLPI REST v1 API, including its API path.
# GLPI_APP_TOKEN: Application token for the configured GLPI API client.
# GLPI_USER_TOKEN: User token for the scoped GLPI service account.
# IDENTITY_CODE_SECRET: 32-byte hex key for verification code and mailbox digests.
# IDENTITY_ALLOWED_EMAIL_DOMAINS: Exact corporate email domains eligible for employee verification.
# IDENTITY_SMTP_HOST: SMTP submission server used for employee verification email.
# IDENTITY_SMTP_PORT=587  # SMTP submission port. Port 465 uses implicit TLS. Other ports require STARTTLS.
# IDENTITY_SMTP_USER: SMTP service credential username for employee verification mail.
# IDENTITY_SMTP_PASSWORD: SMTP service credential password for employee verification mail.
# IDENTITY_SMTP_FROM: Authorized From mailbox for employee verification email.
# WHATSAPP_SUPPORT_CONTACT: IT contact shown by the WhatsApp menu. Enables guided conversations with configured integrations.
